<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import com.example.nienluancoso_grapheditor.view.NotificationView?>

<BorderPane fx:id="root" prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.nienluancoso_grapheditor.HelloController">
    <top>
        <VBox id="topContainer" fx:id="topContainer" BorderPane.alignment="CENTER">
            <children>
                <MenuBar minHeight="-Infinity" minWidth="-Infinity">
                    <menus>
                        <Menu mnemonicParsing="false" text="File">
                            <items>
                                <MenuItem mnemonicParsing="false" text="New" />
                                <MenuItem mnemonicParsing="false" text="Open" />
                                <MenuItem mnemonicParsing="false" text="Save" />
                                <MenuItem mnemonicParsing="false" text="Save As" />
                                <MenuItem mnemonicParsing="false" text="Exit" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Edit">
                            <items>
                                <MenuItem mnemonicParsing="false" text="Undo" />
                                <MenuItem mnemonicParsing="false" text="Redo" />
                                <MenuItem mnemonicParsing="false" text="Delete" />
                                <MenuItem mnemonicParsing="false" text="Clear Graph" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="View">
                            <items>
                                <MenuItem mnemonicParsing="false" text="Show Grid" />
                                <MenuItem mnemonicParsing="false" text="Reset View" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Algorithm">
                            <items>
                                <MenuItem mnemonicParsing="false" text="Connected Components" />
                                <MenuItem mnemonicParsing="false" text="BFS" />
                                <MenuItem mnemonicParsing="false" text="DFS" />
                                <MenuItem mnemonicParsing="false" text="Shortest Path" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Help">
                            <items>
                                <MenuItem mnemonicParsing="false" text="User Guide" />
                                <MenuItem mnemonicParsing="false" text="About" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
                <Separator prefWidth="200.0" />
                <ToolBar minHeight="-Infinity" minWidth="-Infinity">
                    <items>
                        <Button mnemonicParsing="false" text="New" />
                        <Button mnemonicParsing="false" text="Open" />
                        <Button mnemonicParsing="false" text="Save" />
                        <Separator orientation="VERTICAL" />
                        <Button mnemonicParsing="false" text="Undo" />
                        <Button mnemonicParsing="false" text="Redo" />
                        <Separator orientation="VERTICAL" />
                        <Button mnemonicParsing="false" onAction="#deleteSelected" text="Delete" />
                        <Button mnemonicParsing="false" text="Clear" />
                  <Separator orientation="VERTICAL" />
                    </items>
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
                </ToolBar>
            </children>
        </VBox>
    </top>
    <center>
        <Pane id="graphPane" fx:id="graphPane" prefHeight="313.0" prefWidth="729.0" BorderPane.alignment="CENTER">
            <NotificationView fx:id="notificationView" mouseTransparent="true" />
        </Pane>
    </center>
    <bottom>
        <HBox id="botContainer" fx:id="botContainer" prefHeight="48.0" prefWidth="1000.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Ready">
                    <HBox.margin>
                        <Insets bottom="5.0" left="15.0" right="5.0" top="5.0" />
                    </HBox.margin>
                </Label>
                <Region HBox.hgrow="ALWAYS">
               <padding>
                  <Insets top="5.0" />
               </padding></Region>
                <Label text="Vertices: 0">
                    <HBox.margin>
                        <Insets right="15.0" top="5.0" />
                    </HBox.margin>
                </Label>
                <Separator orientation="VERTICAL" prefWidth="6.0" />
                <Label text="Edges: 0">
                    <HBox.margin>
                        <Insets left="15.0" right="15.0" top="5.0" />
                    </HBox.margin>
                </Label>
            <Separator orientation="VERTICAL">
               <HBox.margin>
                  <Insets right="30.0" />
               </HBox.margin>
            </Separator>
            <Button mnemonicParsing="false" onAction="#handleZoomOut" prefHeight="26.0" prefWidth="26.0" text="-">
               <HBox.margin>
                  <Insets right="5.0" />
               </HBox.margin>
            </Button>
            <Slider fx:id="zoomSlider" blockIncrement="0.1" majorTickUnit="1.5" max="2.0" min="0.5" minorTickCount="14" showTickLabels="true" snapToTicks="true" value="1.0">
               <padding>
                  <Insets top="7.0" />
               </padding>
            </Slider>
            <Button mnemonicParsing="false" onAction="#handleZoomIn" prefHeight="26.0" prefWidth="26.0" text="+">
               <HBox.margin>
                  <Insets left="5.0" />
               </HBox.margin>
            </Button>
            <Label fx:id="zoomSliderLabel" alignment="CENTER" contentDisplay="CENTER" prefHeight="20.0" prefWidth="50.0" text="100%" textAlignment="CENTER">
               <HBox.margin>
                  <Insets left="10.0" right="10.0" top="4.0" />
               </HBox.margin>
            </Label>
            <Button mnemonicParsing="false" onAction="#handleResetZoom" text="Reset">
               <HBox.margin>
                  <Insets right="140.0" />
               </HBox.margin>
            </Button>
            </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets top="10.0" />
         </padding>
        </HBox>
    </bottom>
    <left>
        <HBox id="leftContainer" fx:id="leftContainer" BorderPane.alignment="CENTER">
            <children>
                <VBox fx:id="leftPanel">
                    <children>
                        <Label fx:id="featurePaneLabel" styleClass="headingLabel" text="FEATURE">
                            <padding>
                                <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
                            </padding>
                        </Label>
                  <HBox>
                     <children>
                        <Button mnemonicParsing="false" text="Algorithm" />
                        <Button mnemonicParsing="false" text="Graph" />
                        <Button mnemonicParsing="false" text="Exercise" />
                     </children>
                  </HBox>
                  <StackPane />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
                <Button fx:id="leftToggleButton" mnemonicParsing="false" onAction="#leftPanelToggleHandle" text="◀">
                    <HBox.margin>
                        <Insets right="5.0" top="5.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>
    </left>
</BorderPane>
