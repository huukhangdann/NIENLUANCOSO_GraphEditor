<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.nienluancoso_grapheditor.HelloController">
   <top>
      <VBox id="topContainer" fx:id="topContainer" BorderPane.alignment="CENTER">
         <children>
            <MenuBar minHeight="-Infinity" minWidth="-Infinity">
              <menus>
                <Menu mnemonicParsing="false" text="File">
                  <items>
                    <MenuItem mnemonicParsing="false" text="New" />
                        <MenuItem mnemonicParsing="false" text="Open" />
                        <MenuItem mnemonicParsing="false" text="Save" />
                        <MenuItem mnemonicParsing="false" text="Save As" />
                        <MenuItem mnemonicParsing="false" text="Exit" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Edit">
                  <items>
                    <MenuItem mnemonicParsing="false" text="Undo" />
                        <MenuItem mnemonicParsing="false" text="Redo" />
                        <MenuItem mnemonicParsing="false" text="Delete" />
                        <MenuItem mnemonicParsing="false" text="Clear Graph" />
                  </items>
                </Menu>
                  <Menu mnemonicParsing="false" text="View">
                    <items>
                      <MenuItem mnemonicParsing="false" text="Show Grid" />
                        <MenuItem mnemonicParsing="false" text="Reset View" />
                    </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="Algorithm">
                    <items>
                      <MenuItem mnemonicParsing="false" text="Connected Components" />
                        <MenuItem mnemonicParsing="false" text="BFS" />
                        <MenuItem mnemonicParsing="false" text="DFS" />
                        <MenuItem mnemonicParsing="false" text="Shortest Path" />
                    </items>
                  </Menu>
                <Menu mnemonicParsing="false" text="Help">
                  <items>
                        <MenuItem mnemonicParsing="false" text="User Guide" />
                    <MenuItem mnemonicParsing="false" text="About" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
            <Separator prefWidth="200.0" />
            <ToolBar minHeight="-Infinity" minWidth="-Infinity">
              <items>
                  <Button mnemonicParsing="false" text="New" />
                  <Button mnemonicParsing="false" text="Open" />
                <Button mnemonicParsing="false" text="Save" />
                  <Separator orientation="VERTICAL" />
                  <Button mnemonicParsing="false" text="Undo" />
                  <Button mnemonicParsing="false" text="Redo" />
                  <Separator orientation="VERTICAL" />
                  <Button mnemonicParsing="false" text="Delete" />
                  <Button mnemonicParsing="false" text="Clear" />
              </items>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </ToolBar>
         </children>
      </VBox>
   </top>
   <center>
      <Pane id="graphPane" fx:id="graphPane" prefHeight="313.0" prefWidth="299.0" BorderPane.alignment="CENTER" />
   </center>
   <bottom>
      <HBox id="botContainer" fx:id="botContainer" prefHeight="23.0" prefWidth="600.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Ready">
               <HBox.margin>
                  <Insets bottom="5.0" left="15.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Vertices: 0">
               <HBox.margin>
                  <Insets right="15.0" top="5.0" />
               </HBox.margin>
            </Label>
            <Separator orientation="VERTICAL" />
            <Label text="Edges: 0">
               <HBox.margin>
                  <Insets left="15.0" right="15.0" top="5.0" />
               </HBox.margin>
            </Label>
         </children></HBox>
   </bottom>
   <left>
      <HBox id="leftContainer" fx:id="leftContainer" BorderPane.alignment="CENTER">
         <children>
            <VBox fx:id="leftPanel" prefHeight="562.0" prefWidth="194.0">
               <children>
                  <Label styleClass="headingLabel" text="Graph">
                     <padding>
                        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
                     </padding>
                  </Label>
                  <Separator prefWidth="200.0">
                     <padding>
                        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
                     </padding>
                  </Separator>
                  <Label text="Graph Settings">
                     <padding>
                        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
                     </padding>
                  </Label>
                  <CheckBox mnemonicParsing="false" text="Show Grid">
                     <padding>
                        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
                     </padding>
                  </CheckBox>
                  <CheckBox mnemonicParsing="false" text="Snap to Grid">
                     <padding>
                        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
                     </padding>
                  </CheckBox>
                  <Separator prefWidth="200.0">
                     <padding>
                        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
                     </padding>
                  </Separator>
                  <Label text="Actions">
                     <padding>
                        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
                     </padding>
                  </Label>
                  <Button mnemonicParsing="false" text="Clear Graph">
                     <padding>
                        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
                     </padding>
                  </Button>
                  <Button mnemonicParsing="false" text="Reset View">
                     <padding>
                        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
                     </padding>
                     <VBox.margin>
                        <Insets top="8.0" />
                     </VBox.margin>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <Button fx:id="leftToggleButton" mnemonicParsing="false" onAction="#leftPanelToggleHandle" text="◀">
               <HBox.margin>
                  <Insets right="5.0" top="5.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </left>
   <right>
      <HBox id="rightContainer" fx:id="rightContainer" prefWidth="290.0" BorderPane.alignment="CENTER_RIGHT">
         <children>
            <VBox fx:id="rightPanel" prefWidth="160.0">
               <children>
                  <Label styleClass="headingLabel" text="Properties">
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </Label>
                  <Separator prefWidth="200.0" />
                  <Label text="Selected Object">
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>
   </right>
</BorderPane>
