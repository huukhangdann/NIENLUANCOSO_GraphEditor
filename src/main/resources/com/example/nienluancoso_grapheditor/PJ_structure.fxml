<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import com.example.nienluancoso_grapheditor.view.NotificationView?>

<BorderPane fx:id="root" prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.nienluancoso_grapheditor.HelloController">
    <top>
        <VBox id="topContainer" fx:id="topContainer" BorderPane.alignment="CENTER">
            <children>
                <MenuBar fx:id="topMenuBar">
                    <menus>
                        <Menu fx:id="MenuBarFile" mnemonicParsing="false" text="File">
                            <items>
                                <MenuItem fx:id="MenuItemNew" mnemonicParsing="false" text="New" />
                                <MenuItem fx:id="MenuItemOpen" mnemonicParsing="false" text="Open" />
                                <MenuItem fx:id="MenuItemSave" mnemonicParsing="false" text="Save" />
                                <MenuItem fx:id="MenuItemSaveAs" mnemonicParsing="false" text="Save As" />
                                <MenuItem fx:id="MenuItemExit" mnemonicParsing="false" text="Exit" />
                            </items>
                        </Menu>
                        <Menu fx:id="MenuBarEdit" mnemonicParsing="false" text="Edit">
                            <items>
                                <MenuItem fx:id="MenuItemUndo" mnemonicParsing="false" text="Undo" />
                                <MenuItem fx:id="MenuItemRedo" mnemonicParsing="false" text="Redo" />
                                <MenuItem fx:id="MenuItemDelete" mnemonicParsing="false" text="Delete" />
                                <MenuItem fx:id="MenuItemClearGraph" mnemonicParsing="false" text="Clear Graph" />
                            </items>
                        </Menu>
                        <Menu fx:id="MenuBarView" mnemonicParsing="false" text="View">
                            <items>
                                <MenuItem fx:id="MenuItemShowGrid" mnemonicParsing="false" text="Show Grid" />
                                <MenuItem fx:id="MenuItemResetView" mnemonicParsing="false" text="Reset View" />
                            </items>
                        </Menu>
                        <Menu fx:id="MenuBarHelp" mnemonicParsing="false" text="Help">
                            <items>
                                <MenuItem mnemonicParsing="false" text="User Guide" />
                                <MenuItem mnemonicParsing="false" text="About" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
                <ToolBar fx:id="TopToolBar">
                    <items>
                        <Button fx:id="ButtonNew" mnemonicParsing="false" text="New" />
                        <Button fx:id="ButtonOpen" mnemonicParsing="false" text="Open" />
                        <Button fx:id="ButtonSave" mnemonicParsing="false" text="Save" />
                        <Separator orientation="VERTICAL" />
                        <Button fx:id="ButtonUndo" mnemonicParsing="false" text="Undo" />
                        <Button fx:id="ButtonRedo" mnemonicParsing="false" text="Redo" />
                        <Separator orientation="VERTICAL" />
                        <Button fx:id="ButtonDelete" mnemonicParsing="false" onAction="#deleteSelected" text="Delete" />
                        <Button fx:id="ButtonClear" mnemonicParsing="false" text="Clear" onAction="#deleteAll"/>
                    </items>
                </ToolBar>
            </children>
        </VBox>
    </top>
    <center>
        <Pane id="graphPane" fx:id="graphPane" BorderPane.alignment="CENTER">
            <children>
                <NotificationView fx:id="notificationView" mouseTransparent="true" />
            </children>
        </Pane>
    </center>
    <bottom>
        <HBox id="botContainer" fx:id="botContainer" alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Ready" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Vertices: 0" />
                <Separator orientation="VERTICAL" />
                <Label text="Edges: 0" />
                <Separator orientation="VERTICAL" />
                <HBox alignment="CENTER" spacing="6.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleZoomOut" styleClass="icon-btn" text="-" />
                        <Slider fx:id="zoomSlider" blockIncrement="0.1" max="2.0" min="0.5" prefWidth="120.0" value="1.0" />
                        <Button mnemonicParsing="false" onAction="#handleZoomIn" styleClass="icon-btn" text="+" />
                        <Label fx:id="zoomSliderLabel" alignment="CENTER" prefWidth="45.0" text="100%" />
                        <Button mnemonicParsing="false" onAction="#handleResetZoom" text="Reset" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
            </padding>
        </HBox>
    </bottom>
    <left>
        <VBox id="leftPanel" fx:id="leftPanel" prefWidth="280.0" spacing="12.0" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="featurePaneLabel" styleClass="headingLabel" text="FEATURE" />

                <HBox fx:id="GroupButtonNavigation" spacing="4.0">
                    <children>
                        <ToggleButton fx:id="algorithmButtonNav" maxWidth="1.17649232938E30" mnemonicParsing="false" text="Algorithm" HBox.hgrow="ALWAYS">
                            <toggleGroup>
                                <ToggleGroup fx:id="navigationGroup" />
                            </toggleGroup>
                        </ToggleButton>
                        <ToggleButton fx:id="graphButtonNav" maxWidth="1.17649232938E30" mnemonicParsing="false" text="Graph" toggleGroup="$navigationGroup" HBox.hgrow="ALWAYS" />
                        <ToggleButton fx:id="exerciseButtonNav" maxWidth="1.17649232938E30" mnemonicParsing="false" text="Exercise" toggleGroup="$navigationGroup" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <Separator />

                <StackPane fx:id="leftStackPane" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox fx:id="algorithmPanel" spacing="14.0">
                            <children>
                                <VBox fx:id="algorithmSelectionSection" spacing="6.0">
                                    <children>
                                        <Label fx:id="sectionTitle" styleClass="subHeadingLabel" text="Select Algorithm" />
                                        <ComboBox fx:id="algorithmComboBox" maxWidth="1.17649232938E30" promptText="Choose an algorithm">
                                            <items>
                                                <FXCollections fx:factory="observableArrayList">
                                                    <String fx:value="Moore Dijkstra" />
                                                    <String fx:value="BFS" />
                                                    <String fx:value="DFS" />
                                                    <String fx:value="Count Component" />
                                                </FXCollections>
                                            </items>
                                        </ComboBox>
                                    </children>
                                </VBox>

                                <VBox fx:id="algorithmInputSection" spacing="10.0">
                                    <children>
                                        <Label fx:id="inputTitle" styleClass="subHeadingLabel" text="Input" />
                                        <VBox fx:id="sourceSection" spacing="4.0">
                                            <children>
                                                <Label fx:id="sourceLabel" styleClass="fieldLabel" text="Source Vertex" />
                                                <ComboBox fx:id="sourceComboBox" maxWidth="1.17649232938E30" promptText="Choose source Vertex" />
                                            </children>
                                        </VBox>
                                        <VBox fx:id="targetSection" spacing="4.0">
                                            <children>
                                                <Label fx:id="targetLabel" styleClass="fieldLabel" text="Target Vertex" />
                                                <ComboBox fx:id="targetComboBox" maxWidth="1.17649232938E30" promptText="Choose target Vertex" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <VBox fx:id="algorithmOptionsSection" spacing="6.0">
                                    <children>
                                        <Label fx:id="optionsTitle" styleClass="subHeadingLabel" text="Animation Speed" />
                                        <Slider fx:id="speedSlider" blockIncrement="1.0" majorTickUnit="1.0" max="2.0" min="1.0" minorTickCount="2" showTickMarks="true" snapToTicks="true" value="1.0">
                                 <VBox.margin>
                                    <Insets />
                                 </VBox.margin></Slider>
                                        <HBox>
                                            <children>
                                                <Label styleClass="fieldLabel" text="Slow" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label styleClass="fieldLabel" text="Fast" />
                                            </children>
                                 <VBox.margin>
                                    <Insets top="-10.0" />
                                 </VBox.margin>
                                        </HBox>
                                    </children>
                                </VBox>

                                <Region VBox.vgrow="ALWAYS" />

                                <VBox fx:id="algorithmControlsSection" spacing="10.0">
                                    <children>
                                        <HBox spacing="8.0">
                                            <children>
                                                <Button fx:id="runButton" maxWidth="1.17649232938E30" mnemonicParsing="false" text="Run" HBox.hgrow="ALWAYS" />
                                                <Button fx:id="stepButton" maxWidth="1.17649232938E30" mnemonicParsing="false" text="Step" HBox.hgrow="ALWAYS" />
                                                <Button fx:id="resetButton" maxWidth="1.17649232938E30" mnemonicParsing="false" text="Reset" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="algorithmStatusLabel" styleClass="statusLabel" text="Algorithm Status: Ready" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                        <VBox fx:id="graphPanel" mouseTransparent="true" visible="false" />
                        <VBox fx:id="exercisePanel" mouseTransparent="true" visible="false" />
                    </children>
                </StackPane>
            </children>
            <padding>
                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
            </padding>
        </VBox>
    </left>
</BorderPane>
